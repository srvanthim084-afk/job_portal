# dependencies
node_modules/

# secrets — never commit a filled-in environment
.env
.env.*
!.env.example

# runtime state: the local database, uploaded resumes, backups, logs
var/
api/var/
*.log

# UI snapshots are DERIVED data — 3.7MB of JSON plus 12MB of PNGs, all
# regenerated from baseline/prototype.html by:
#     npm run ui:capture baseline
ui-snapshots/

# The place index under var/places/ is DERIVED too — 21MB of villages,
# built from the GeoNames India dump (CC-BY 4.0). Without it the location
# filter falls back to the 1,244 places in web/index.html and says so;
# with it, Chittoor at 25 km lists 859 villages instead of one. Rebuild:
#     curl -LO https://download.geonames.org/export/dump/IN.zip
#     unzip IN.zip
#     node tools/build-place-index.mjs IN.txt

# OS noise
Thumbs.db
.DS_Store

# Saved single-file copy of the portal (made by tools/export-single-file.mjs). It has no server behind it,
# so opening it shows an old sample screen. Never commit it.
TeamLink_JobPortal_Backend_Integrated.html
TeamLink_JobPortal_Backend_Integrated_files/
