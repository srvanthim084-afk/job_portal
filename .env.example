# TeamLink — environment configuration
#
# Copy this to `.env` and fill in the values. `.env` is gitignored and must
# never be committed: everything here is a credential or an identity that
# belongs to your organisation.
#
# NOTHING in this file is read by the browser. The frontend calls /api and
# the server holds the keys, which is the whole point of the split.

# ── database ──────────────────────────────────────────────────────────
# Leave unset locally to use the embedded PostgreSQL in var/dev-db.
# For real business data, point this at a real server.
# DATABASE_URL=postgres://app_api:password@host:5432/teamlink
# ADMIN_DATABASE_URL=postgres://postgres:password@host:5432/teamlink

# ── the site ──────────────────────────────────────────────────────────
# PUBLIC_ORIGIN=https://jobs.teamlinkcs.com
# AUTH_SECRET=<64 random characters; generate, do not invent>

# ── email ─────────────────────────────────────────────────────────────
# SMTP (what TeamLink's mail settings screen shows). When EMAIL_SMTP_HOST
# is set, SMTP is used and EMAIL_API_KEY is ignored.
#
# EMAIL_SMTP_PASS is the mailbox password. It is NOT in this file and must
# be added before any email can be sent — until then every send records
# `not_configured` rather than claiming it went out.
EMAIL_SMTP_HOST=mail.yourdomain.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=info@yourdomain.com
EMAIL_SMTP_PASS=
EMAIL_FROM=info@yourdomain.com

# ── SMS ───────────────────────────────────────────────────────────────
# SMS_SENDER_ID is what the recipient sees as the sender. In India this is
# a 6-character DLT-registered header for transactional SMS, not a phone
# number — check what your provider issued you.
# The header can also be set on the channels screen, which is where the
# DLT entity and template ids live. Those are not secrets - they are
# registration numbers printed on the message - so they belong in the
# database where a recruiter can change them when the operator approves
# new wording, rather than in a file that needs a redeploy.
SMS_SENDER_ID=
SMS_API_KEY=
SMS_API_URL=

# ── WhatsApp ──────────────────────────────────────────────────────────
# WhatsApp Business (Meta Cloud API). The number is identified by its
# PHONE NUMBER ID, which Meta issues in the WhatsApp Manager — it is not
# the phone number itself, though it represents this one:
#   business number: +91 90323 21414
WHATSAPP_PHONE_ID=
WHATSAPP_API_KEY=
# WHATSAPP_API_URL=https://graph.facebook.com/v21.0
#
# The APPROVED TEMPLATE NAME is set on the channels screen, not here.
# Meta allows free text only inside the 24 hours after the candidate
# writes to us; a stage update is business-initiated, so without a
# template it is rejected however correct the key is.

# ── Naukri ────────────────────────────────────────────────────────────
NAUKRI_API_URL=
NAUKRI_API_KEY=
NAUKRI_EMPLOYER_ID=

# ── AI ────────────────────────────────────────────────────────────────
# With this set, resume parsing and interview scoring use a model instead
# of the deterministic parser. Without it, they say so rather than
# pretending a model was involved.
AI_API_KEY=
# AI_MODEL=claude-sonnet-4-5

# ── the external ATS a BDE pushes to ──────────────────────────────────
# ATS_NAME=ceipal
# ATS_URL=https://api.example-ats.com/v1/candidates
# ATS_API_KEY=
