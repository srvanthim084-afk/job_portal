# =====================================================================
# TeamLink Job Portal — environment (requirement 21)
#
# Copy to .env and fill in. NOTHING in here belongs in frontend code:
# every value is read server-side only.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a filled-in copy.
# =====================================================================

NODE_ENV=production
PORT=8080

# ---------------------------------------------------------------------
# Database
#
# MUST connect as app_api, NOT as postgres.
#
# Row-level security does not apply to superusers, so a superuser
# connection string silently disables every access policy while the app
# carries on working normally. The server refuses to start if it detects
# this, but get it right here rather than relying on that.
#
#   ALTER ROLE app_api LOGIN PASSWORD '<APP_DB_PASSWORD>';
# ---------------------------------------------------------------------
DATABASE_URL=postgres://app_api:CHANGE_ME@127.0.0.1:5432/teamlink
DB_POOL_MAX=10
DB_SSL=false

# --- docker compose only -------------------------------------------
# Two DIFFERENT credentials, deliberately:
#   POSTGRES_PASSWORD  the superuser. Used by migrations and backups only.
#   APP_DB_PASSWORD    the app_api role the API runs as. RLS applies to it.
# Generate both with:  openssl rand -base64 32 | tr -d '/+='
POSTGRES_DB=teamlink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_superuser_password
APP_DB_PASSWORD=CHANGE_ME_min_16_chars_no_quotes

# Admin connection for tools/migrate.mjs. NEVER give this to the API.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME_superuser_password@127.0.0.1:5432/teamlink

# true loads the prototype's demo content (13 jobs, 10 candidates).
# Leave false for a real deployment — the app works fine with an empty database.
LOAD_SEED=false

# false removes the "Quick demo login" account list from the login screen.
SHOW_LOGIN_HINTS=true

# how many days of backups deploy/backup.sh keeps
BACKUP_KEEP_DAYS=14

# Optional. Drops to this role at the start of every transaction, for
# platforms that only hand out a privileged connection string. Leave blank
# when DATABASE_URL already connects as app_api.
DB_ROLE=

# ---------------------------------------------------------------------
# Authentication
#
# Generate a fresh secret — do not reuse the example:
#   openssl rand -base64 48
# ---------------------------------------------------------------------
AUTH_SECRET=CHANGE_ME_min_32_chars_generate_with_openssl_rand
SESSION_COOKIE=tl_session
SESSION_DAYS=7
# Cost factor. 12 is a sane 2026 default; lower only for tests.
BCRYPT_ROUNDS=12
# Set when the API and the app are on different subdomains.
COOKIE_DOMAIN=

# ---------------------------------------------------------------------
# Origins — used for CORS and the CSRF origin check.
# Must be https in production: session cookies are issued Secure.
# ---------------------------------------------------------------------
PUBLIC_ORIGIN=https://jobs.example.com
EXTRA_ORIGINS=
TRUST_PROXY=true

# ---------------------------------------------------------------------
# File storage (resumes)
#
#   local    — disk at STORAGE_LOCAL_DIR; fine for a single box
#   supabase — Supabase Storage; STORAGE_KEY is the SERVICE key and must
#              never reach the browser. The API issues short-lived signed
#              URLs instead.
# ---------------------------------------------------------------------
STORAGE_DRIVER=supabase
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_URL=https://your-project.supabase.co
STORAGE_KEY=CHANGE_ME_service_role_key_server_side_only
STORAGE_BUCKET=resumes
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------
# Outbound providers (requirement 14)
#
# Optional — the related features degrade rather than crash when a key is
# absent. These previously sat in localStorage where any visitor could
# read them (teamlink_whatsapp_api_v1, teamlink_sms_api_v1).
# ---------------------------------------------------------------------
# An UNCONFIGURED channel reports "not_configured" on the application
# record. It never reports "sent" — a candidate must never be recorded as
# contacted when no message was sent.

# Email — defaults to the Resend API shape; EMAIL_API_URL retargets it at
# any provider taking the same payload.
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=TeamLink <careers@yourdomain.com>

# SMS — any gateway accepting {to, sender, message}
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# WhatsApp — Cloud API
WHATSAPP_API_KEY=
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_ID=

# Naukri employer API.
#
# There is no open endpoint and no default. Access is granted per employer
# account, and the URL, auth scheme and payload come from that agreement.
# Until these are set the Naukri channel reports "not_configured" and is
# only attempted at all for applications whose source is naukri.
NAUKRI_API_URL=
NAUKRI_API_KEY=
NAUKRI_EMPLOYER_ID=

AI_API_KEY=

# ---------------------------------------------------------------------
# Rate limiting (requirement 19)
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Counts only FAILED sign-in attempts, so a legitimate user is never
# locked out by someone else hammering their address.
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------
# Seeding (used once by `npm run seed:auth`)
#
# Leave blank to have strong random passwords generated and printed once.
# ---------------------------------------------------------------------
SEED_ADMIN_PASSWORD=
SEED_RECRUITER_PASSWORD=
SEED_CLIENT_PASSWORD=
SEED_CANDIDATE_PASSWORD=
