{
  "name": "teamlink-job-portal",
  "private": true,
  "version": "1.0.0",
  "description": "TeamLink Job Portal — production backend for the existing prototype UI",
  "type": "module",
  "scripts": {
    "verify:schema": "node tools/verify-schema.mjs",
    "verify:rls": "node tools/verify-rls.mjs",
    "verify:seed": "node tools/verify-seed.mjs",
    "verify:db": "npm run verify:schema && npm run verify:rls && npm run verify:seed && npm run verify:migrate",
    "seed:generate": "node tools/extract-seed.mjs",
    "ui:capture": "node tools/ui-snapshot.mjs capture",
    "ui:compare": "node tools/ui-snapshot.mjs compare",
    "verify:all": "npm run verify:db && npm run test:api",
    "test:api": "npm --prefix api test",
    "dev": "node tools/dev-server.mjs 4323",
    "build:web": "node web/build.mjs",
    "demo:fixtures": "node tools/extract-demo-fixtures.mjs",
    "verify:migrate": "node tools/verify-migrate.mjs",
    "migrate": "node tools/migrate.mjs",
    "migrate:status": "node tools/migrate.mjs --status",
    "verify:search": "node tools/verify-search.mjs",
    "verify:interaction": "node tools/verify-interaction.mjs",
    "verify:live": "npm run verify:interaction && npm run verify:search && npm run verify:candidate && npm run verify:resume && npm run verify:interview && npm run verify:notifications && npm run verify:easy-apply && npm run verify:source && npm run verify:deadline && npm run verify:matching && npm run verify:calling && npm run verify:calling-ui && npm run verify:spreadsheet && npm run verify:intake && npm run verify:intake-ui && npm run verify:screening && npm run verify:retry && npm run verify:channels-ui && npm run verify:invite && npm run verify:isolation",
    "verify:stack": "node tools/verify-stack.mjs",
    "watch": "node tools/watch.mjs",
    "watch:push": "node tools/watch.mjs --push",
    "sync": "node tools/sync.mjs",
    "rehearse": "node tools/rehearse.mjs",
    "verify:candidate": "node tools/verify-candidate-flow.mjs",
    "export:single": "node tools/export-single-file.mjs",
    "verify:resume": "node tools/verify-resume.mjs",
    "test:resumes": "node tools/make-test-resumes.mjs",
    "verify:interview": "node tools/verify-interview.mjs",
    "verify:notifications": "node tools/verify-notifications.mjs",
    "verify:easy-apply": "node tools/verify-easy-apply.mjs",
    "mail:sink": "node tools/mail-sink.mjs",
    "mail:inbox": "node tools/mail-inbox.mjs",
    "mail:journey": "node tools/send-to-candidate.mjs",
    "verify:source": "node tools/verify-source.mjs",
    "verify:deadline": "node tools/verify-deadline.mjs",
    "check:mail": "node tools/check-mail.mjs",
    "verify:matching": "node tools/verify-matching.mjs",
    "verify:calling": "node tools/verify-ai-calling.mjs",
    "verify:calling-ui": "node tools/verify-calling-ui.mjs",
    "verify:spreadsheet": "node tools/verify-spreadsheet.mjs",
    "verify:intake": "node tools/verify-intake.mjs",
    "verify:intake-ui": "node tools/verify-intake-ui.mjs",
    "verify:screening": "node tools/verify-screening.mjs",
    "verify:retry": "node tools/verify-retry.mjs",
    "verify:channels-ui": "node tools/verify-channels-ui.mjs",
    "verify:invite": "node tools/verify-invite.mjs",
    "verify:isolation": "node tools/verify-isolation.mjs",
    "send:credentials": "node tools/send-credentials.mjs",
    "intake:cleanup": "node tools/intake-cleanup.mjs",
    "intake:connect": "node tools/connect-mailbox.mjs"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "js-yaml": "^5.4.2",
    "pg": "^8.23.0",
    "smtp-server": "^3.19.13"
  }
}
